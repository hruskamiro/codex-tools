#!/usr/bin/env bash
set -euo pipefail
project_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
python_bin="${CODEX_TOOLS_PYTHON:-${project_root}/.venv/bin/python}"
if [[ ! -x "${python_bin}" ]]; then
  python_bin=python3
fi
export PYTHONPATH="${project_root}${PYTHONPATH:+:${PYTHONPATH}}"
if ! "${python_bin}" -m codex_tools.relay token >/dev/null 2>&1; then
  "${python_bin}" -m codex_tools.relay init
fi
exec "${python_bin}" -m codex_tools.relay serve --host 127.0.0.1 "$@"
